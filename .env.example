# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# LLM Configuration (OpenAI-compatible)
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:4b-it-qat

# Ollama Configuration (for direct client usage)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b-it-qat

# PostgreSQL Database
DATABASE_URL=postgresql://finance_user:finance_pass@postgres:5432/finance_bot
POSTGRES_PASSWORD=finance_pass

# SQLite (fallback)
SQLITE_PATH=data/expenses.db

# Excel Storage
EXCEL_PATH=data/expenses.xlsx

# Logging
LOG_LEVEL=INFO